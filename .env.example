# Copy this file to .env and fill it in. NEVER commit .env or share it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Long random code Ajmal types once on his device. Leave empty = no code.
ACCESS_CODE=
# Your real site address(es), comma separated. Add https://yourdomain.com when you deploy.
ALLOWED_ORIGINS=http://localhost:3000
DAILY_LIMIT=300
PORT=3000
# Set to 1 only when running behind a proxy/host that forwards the real IP.
TRUST_PROXY=0

# 1 = use the public LanguageTool API as an additional grammar/spelling layer. 0 = local rules + OpenAI only.
LANGUAGETOOL_ENABLED=1
